FROM apache/superset:6.1.0

USER root

# ---------------------------------------------------------
# Install Shillelagh + Generic JSON API dependencies
# ---------------------------------------------------------
RUN uv pip install --python /app/.venv/bin/python --no-cache --force-reinstall \
    "shillelagh==1.4.5" \
    "shillelagh[genericjsonapi]==1.4.5" \
    "prison>=0.2.1" \
    "python-jsonpath>=0.10.3" \
    "yarl>=1.8.1"

# Superset 6.1 compatibility
RUN uv pip install --python /app/.venv/bin/python --no-cache \
    "sqlalchemy==1.4.54"

# ---------------------------------------------------------
# Create writable temporary directories
# ---------------------------------------------------------
RUN mkdir -p /tmp/shillelagh-cache \
    && mkdir -p /tmp/shillelagh-home \
    && chmod -R 777 /tmp/shillelagh-cache \
    && chmod -R 777 /tmp/shillelagh-home

ENV HOME=/tmp/shillelagh-home
ENV XDG_CACHE_HOME=/tmp/shillelagh-cache

# ---------------------------------------------------------
# Verify installation during Docker build
# ---------------------------------------------------------
RUN /app/.venv/bin/python -c \
    "import shillelagh; print('SHILLELAGH VERSION:', shillelagh.__version__)"

RUN /app/.venv/bin/python -c \
    "from shillelagh.adapters.api.generic_json import GenericJSONAPI; print('GENERIC JSON API ADAPTER: OK')"

RUN /app/.venv/bin/python -c \
    "import jsonpath; print('JSONPATH: OK')"

RUN /app/.venv/bin/python -c \
    "import requests_cache; print('REQUESTS CACHE:', requests_cache.__version__)"

RUN /app/.venv/bin/python -c \
    "import yarl; print('YARL:', yarl.__version__)"

# ---------------------------------------------------------
# Superset configuration
# ---------------------------------------------------------
COPY superset_config.py /app/pythonpath/superset_config.py

USER superset

ENV SUPERSET_CONFIG_PATH=/app/pythonpath/superset_config.py
ENV SUPERSET_LOAD_EXAMPLES=no
ENV SUPERSET_WEBSERVER_WORKERS=1
ENV SERVER_THREADS_AMOUNT=2

# Render provides PORT automatically
EXPOSE 10000

# ---------------------------------------------------------
# Start Superset
# ---------------------------------------------------------
CMD ["sh", "-c", "superset db upgrade && superset fab create-admin --username admin --firstname Superset --lastname Admin --email admin@example.com --password \"$ADMIN_PASSWORD\" || true; superset init; exec gunicorn -w 1 -k gthread --threads 2 -b 0.0.0.0:${PORT:-10000} 'superset.app:create_app()'"]
