FROM apache/superset:6.1.0

USER root

# Install Shillelagh Generic JSON API — force reinstall so the extra's
# dependencies (prison, python-jsonpath, yarl) actually get pulled in,
# since the base image already ships shillelagh==1.4.5
RUN uv pip install --python /app/.venv/bin/python --no-cache --force-reinstall \
    "shillelagh[genericjsonapi]==1.4.5" "prison>=0.2.1" "python-jsonpath>=0.10.3" "yarl>=1.8.1"

# Verify Shillelagh
RUN /app/.venv/bin/python -c \
    "import shillelagh; print('SHILLELAGH VERSION:', shillelagh.__version__)"

# Verify Generic JSON adapter
RUN /app/.venv/bin/python -c \
    "from shillelagh.adapters.api.generic_json import GenericJSONAPI; print('GENERIC JSON API ADAPTER: OK')"

# Verify JSONPath
RUN /app/.venv/bin/python -c \
    "import jsonpath; print('JSONPATH: OK')"

# Verify YARL
RUN /app/.venv/bin/python -c \
    "import yarl; print('YARL:', yarl.__version__)"

# Verify API connectivity
RUN /app/.venv/bin/python -c \
    "import requests; r=requests.get('https://analytics-api-82mg.onrender.com/api/product-performance/categories', timeout=30); print('API STATUS:', r.status_code); print('API CONTENT TYPE:', r.headers.get('content-type')); r.raise_for_status()"

# Verify Shillelagh dialect
RUN /app/.venv/bin/python -c \
    "from sqlalchemy import create_engine; engine=create_engine('shillelagh+safe://'); print('SHILLELAGH DIALECT:', engine.dialect)"

# Copy Superset configuration and diagnostic script
COPY superset_config.py /app/pythonpath/superset_config.py
COPY diag.py /app/diag.py

USER superset

ENV SUPERSET_CONFIG_PATH=/app/pythonpath/superset_config.py
ENV SUPERSET_LOAD_EXAMPLES=no
ENV SUPERSET_WEBSERVER_WORKERS=1
ENV SERVER_THREADS_AMOUNT=2

EXPOSE 10000

CMD ["sh", "-c", "/app/.venv/bin/python /app/diag.py; superset db upgrade && superset fab create-admin --username admin --firstname Superset --lastname Admin --email admin@example.com --password \"$ADMIN_PASSWORD\" || true; superset init; gunicorn -w 1 -k gthread --threads 2 -b 0.0.0.0:${PORT:-10000} 'superset.app:create_app()'"]
